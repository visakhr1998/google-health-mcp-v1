# Copy to .env and fill in from Google Cloud Console.
#
#   APIs & Services > Credentials > Create credentials > OAuth client ID
#   Application type: Desktop app        <- required; enables loopback login
#
# Then run:  npm run auth
#
# That opens a browser once, and writes token.json with the refresh token.
# You should never need to set GOOGLE_HEALTH_REFRESH_TOKEN by hand.

GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# Optional. `npm run auth` writes this into token.json for you.
# GOOGLE_HEALTH_REFRESH_TOKEN=

# Optional overrides ---------------------------------------------------------

# Where the token is stored. Defaults to ./token.json next to package.json.
# GOOGLE_HEALTH_TOKEN_PATH=

# Fixed loopback port for the OAuth callback. Only needed if your OAuth client
# is type "Web application" (which requires pre-registered redirect URIs).
# Desktop app clients accept any 127.0.0.1 port, so leave this unset.
# GOOGLE_HEALTH_OAUTH_PORT=

# Set to 0 to disable automatic browser re-auth when the refresh token dies.
# GOOGLE_HEALTH_AUTO_REAUTH=1
